# Every Ludexis container reads this file (env_file: .env in docker-compose.yml).

# --- Server ---------------------------------------------------------------------------------------------------

# Folder on this machine that holds your games; mounted read-only at /games.
GAMES_PATH=/mnt/games

# Port the web UI is served on.
LUDEXIS_PORT=8420

# Image tag: latest follows the newest build; set a release such as 1.0 to pin it.
LUDEXIS_VERSION=latest

# Time zone for scheduled tasks (nightly scan at 02:00 local time by default).
TZ=UTC

# The administrator created on first start. It must choose a new password at its first sign-in.
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin

# Optional HTTPS: a domain name that points at this host. Caddy then gets a certificate for it automatically;
# set LUDEXIS_PORT=80 and LUDEXIS_HTTPS_PORT=443 so the certificate authority can reach it.
# Recommended before exposing Ludexis outside your home network.
LUDEXIS_DOMAIN=
LUDEXIS_HTTPS_PORT=8443

# --- Database -------------------------------------------------------------------------------------------------

# Used by the database container and by the backend to connect to it; only reachable inside the stack.
POSTGRES_USER=ludexis
POSTGRES_PASSWORD=change-me
POSTGRES_DB=ludexis

# --- Metadata -------------------------------------------------------------------------------------------------

# Optional: IGDB credentials from https://dev.twitch.tv/console. They can also be entered in the web UI.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: a SteamGridDB API key (steamgriddb.com, Preferences → API) adds community covers, banners and logos.
STEAMGRIDDB_API_KEY=

# --- Optional -------------------------------------------------------------------------------------------------

# Left empty, a signing secret is generated on first start and kept in the data volume.
JWT_SECRET_KEY=

# Monitoring profile (docker compose --profile monitoring up -d).
GRAFANA_PORT=3000
GRAFANA_ADMIN_PASSWORD=admin
